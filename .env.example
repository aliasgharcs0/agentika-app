# Countersign configuration.
# Local dev: copy to .env and fill in. Alternate Clouds: set the same names on the Variables tab.
# No quotes and no inline comments (podman --env-file keeps them literally).

APP_NAME=Countersign
APP_VERSION=0.1.0
PUBLIC_BASE_URL=http://localhost:8000
DEMO_MODE=true

# Dashboard login. Use a demo account for judges, never a personal password.
ADMIN_EMAIL=demo@countersign.app
ADMIN_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=

# Agents send "Authorization: Bearer <key>" to the REST API and /mcp. openssl rand -hex 24
AGENT_API_KEY=

# Primary LLM: Groq, OpenAI-compatible. Key: https://console.groq.com/keys
# Check current model ids with the command in SETUP.md section 4.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Fallback LLM: Gemini, OpenAI-compatible. Key: https://aistudio.google.com/apikey
FALLBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=gemini-2.5-flash

# Telegram one-tap approvals. Optional: the feature stays off while these are empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=

# Behaviour
REQUEST_TTL_SECONDS=600
AI_REVIEWER_ENABLED=true
