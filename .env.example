# Apprentice builder configuration (n8n/apprentice_n8n.py).
# Copy to .env, fill in, then load it: set -a; . ./.env; set +a
# No quotes and no inline comments.

# Your n8n instance's public API: n8n → Settings → n8n API → Create an API key.
N8N_API_URL=https://agentika-app.alternatefutures.ai/api/v1
N8N_API_KEY=

# AI steps (Verifier and Planner). Optional: without a key, requests are saved but stay at "Checking".
# Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Login for the staff form, manager inbox and channel setup. A password is generated if left empty.
STAFF_FORM_USER=staff
STAFF_FORM_PASSWORD=

# Written by "push all": the secret link that empties the demo data.
RESET_PATH=
RESET_URL=
